<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:AiAgentUi.Converters"
             x:Class="AiAgentUi.App"
             RequestedThemeVariant="Light">
    <Application.Resources>
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:PinFillConverter x:Key="PinFill" />
        <conv:BoolToHorizontalAlignmentConverter x:Key="BoolToHAlign" />
        <conv:IsUserChatBackgroundConverter x:Key="UserChatBg" />
        <conv:IsUserChatBorderConverter x:Key="UserChatBorder" />
        <conv:IsUserRoleForegroundConverter x:Key="UserRoleFg" />

        <SolidColorBrush x:Key="Ink950" Color="#09090B" />
        <SolidColorBrush x:Key="Ink900" Color="#18181B" />
        <SolidColorBrush x:Key="Ink700" Color="#3F3F46" />
        <SolidColorBrush x:Key="Ink500" Color="#71717A" />
        <SolidColorBrush x:Key="Ink400" Color="#A1A1AA" />
        <SolidColorBrush x:Key="BorderHair" Color="#ECECF0" />
        <SolidColorBrush x:Key="Border200" Color="#ECECF0" />
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceMuted" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SurfaceSubtle" Color="#F6F6F7" />

        <SolidColorBrush x:Key="Accent" Color="#6366F1" />
        <SolidColorBrush x:Key="AccentStrong" Color="#4F46E5" />
        <SolidColorBrush x:Key="AccentGlow" Color="#818CF8" />
        <SolidColorBrush x:Key="AccentSoftBg" Color="#EEF2FF" />
        <SolidColorBrush x:Key="AccentSoftBorder" Color="#C7D2FE" />

        <SolidColorBrush x:Key="ChatAgentBg" Color="#FAF8FF" />
        <SolidColorBrush x:Key="ChatAgentBorder" Color="#EDE9FE" />
        <SolidColorBrush x:Key="ChatUserBg" Color="#FFFFFF" />
        <SolidColorBrush x:Key="ChatUserBorder" Color="#ECECF0" />

        <SolidColorBrush x:Key="ShellBackgroundBrush" Color="#FFFFFF" />

        <LinearGradientBrush x:Key="PrimaryButtonBrush" StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#7C3AED" Offset="0" />
            <GradientStop Color="#EC4899" Offset="1" />
        </LinearGradientBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.ghost">
            <Setter Property="Foreground" Value="{StaticResource Ink700}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderHair}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="#FAFAFB" />
            <Setter Property="BorderBrush" Value="#DCDCE2" />
        </Style>
        <Style Selector="Button.ghost:pressed">
            <Setter Property="Background" Value="#F4F4F5" />
        </Style>
        <Style Selector="Button.ghost:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource PrimaryButtonBrush}" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Opacity" Value="0.94" />
        </Style>
        <Style Selector="Button.primary:pressed">
            <Setter Property="Opacity" Value="0.86" />
        </Style>
        <Style Selector="Button.primary:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="SelectionBrush" Value="#C7D2FE" />
            <Setter Property="SelectionForegroundBrush" Value="{StaticResource Ink900}" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
